{
  "manifest_version": 3,
  "name": "GitHub Explorer2",
  "version": "1.0.0",
  "description": "Transforms GitHub with intelligent repository grouping and card-based management",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["public/styles.css"],
      "js": ["node_modules/dexie/dist/dexie.min.js", "src/main.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["node_modules/dexie/dist/dexie.min.js"],
      "matches": ["https://github.com/*"]
    }
  ],
  "icons": {
    "16": "public/assets/github-explorer.png",
    "48": "public/assets/github-explorer.png",
    "128": "public/assets/github-explorer.png"
  }
}
